### AICL DATASET: math/factorial_recursive.aicl
=== SPEC ===
# AICL Example: Factorial Recursive
# AX sub-language — compiles to real code.

Goal:
Recursive

Layer:
Core

Behavior Compute
    Input: n
    Output: result
    Action:
        if n <= 1:
            return 1
        return n * compute(n - 1)

### AICL DATASET: math/fibonacci_iterative.aicl
=== SPEC ===
# AICL Example: Fibonacci Iterative
# AX sub-language — compiles to real code.

Goal:
nth Fibonacci

Layer:
Core

Behavior Compute
    Input: n
    Output: result
    Action:
        if n <= 1:
            return n
        prev = 0
        curr = 1
        for i in range(2, n):
            next = prev + curr
            prev = curr
            curr = next
        return curr

### AICL DATASET: math/gcd_euclid.aicl
=== SPEC ===
# AICL Example: GCD Euclid
# AX sub-language — compiles to real code.

Goal:
GCD

Layer:
Core

Behavior Compute
    Input: a, b
    Output: result
    Action:
        while b != 0:
            temp = b
            b = a % b
            a = temp
        return a

### AICL DATASET: math/is_prime.aicl
=== SPEC ===
# AICL Example: Prime Check
# AX sub-language — compiles to real code.

Goal:
Is prime

Layer:
Core

Behavior Check
    Input: n
    Output: result
    Action:
        if n < 2:
            return false
        i = 2
        while i * i <= n:
            if n % i == 0:
                return false
            i = i + 1
        return true

