        total = 0
        for i in range(0, len(array)):
            total = total + array[i]
        return total // len(array)

### AICL DATASET: statistics/range_value.aicl
=== SPEC ===
# AICL Example: Range
# AX sub-language — compiles to real code.

Goal:
max-min

Layer:
Core

Behavior Range
    Input: array
    Output: range_val
    Action:
        minimum = array[0]
        maximum = array[0]
        for i in range(1, len(array)):
            if array[i] < minimum:
                minimum = array[i]
            if array[i] > maximum:
                maximum = array[i]
        return maximum - minimum

### AICL DATASET: statistics/median_sorted.aicl
=== SPEC ===
# AICL Example: Median Sorted
# AX sub-language — compiles to real code.

Goal:
Median

Layer:
Core

Behavior Median
    Input: array
    Output: median
    Action:
        n = len(array)
        if n == 0:
            return 0
        if n % 2 == 1:
            return array[n // 2]
        return (array[n // 2 - 1] + array[n // 2]) // 2

