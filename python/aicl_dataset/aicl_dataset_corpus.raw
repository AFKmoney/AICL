### AICL DATASET: arrays/max_subarray_sum.aicl
=== SPEC ===
# AICL Example: Max Subarray
# AX sub-language — compiles to real code.

Goal:
Kadane

Layer:
Core

Behavior MaxSub
    Input: array
    Output: max_sum
    Action:
        max_sum = array[0]
        curr_sum = array[0]
        for i in range(1, len(array)):
            if curr_sum + array[i] > array[i]:
                curr_sum = curr_sum + array[i]
            else:
                curr_sum = array[i]
            if curr_sum > max_sum:
                max_sum = curr_sum
        return max_sum

### AICL DATASET: arrays/rotate_array.aicl
=== SPEC ===
# AICL Example: Rotate Array
# AX sub-language — compiles to real code.

Goal:
Right by k

Layer:
Core

Behavior Rotate
    Input: array, k
    Output: result
    Action:
        n = len(array)
        result = []
        for i in range(0, n):
            src = (i + n - k) % n
            result.append(array[src])
        return result

