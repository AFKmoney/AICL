### AICL DATASET: numbertheory/next_prime.aicl
=== SPEC ===
# AICL Example: Next Prime
# AX sub-language — compiles to real code.

Goal:
Smallest prime > n

Layer:
Core

Behavior Find
    Input: n
    Output: result
    Action:
        candidate = n + 1
        while true:
            is_p = true
        d = 2
        while d * d <= candidate:
            if candidate % d == 0:
                is_p = false
        d = d + 1
        if is_p:
            return candidate
        candidate = candidate + 1

### AICL DATASET: numbertheory/is_armstrong.aicl
=== SPEC ===
# AICL Example: Armstrong Number
# AX sub-language — compiles to real code.

Goal:
n == sum of cubes of digits

Layer:
Core

Behavior Check
    Input: n
    Output: result
    Action:
        original = n
        total = 0
        while n > 0:
            digit = n % 10
        total = total + digit * digit * digit
        n = n // 10
        return total == original

### AICL DATASET: numbertheory/reverse_number.aicl
=== SPEC ===
# AICL Example: Reverse Number
# AX sub-language — compiles to real code.

Goal:
Decimal reversal

Layer:
Core

Behavior Reverse
    Input: n
    Output: result
    Action:
        result = 0
        while n > 0:
            result = result * 10 + (n % 10)
        n = n // 10
        return result

