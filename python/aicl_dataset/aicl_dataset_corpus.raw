### AICL DATASET: sorting/bubble_sort.aicl
=== SPEC ===
# AICL Example: Bubble Sort
# AX sub-language — compiles to real code.

Goal:
Sort an array using bubble sort

Risk:
Empty array
Recovery:
Return empty array

Layer:
Core

Behavior Sort
    Input: array
    Output: array
    Action:
        n = len(array)
        for i in range(0, n):
            for j in range(0, n - i - 1):
                if array[j] > array[j + 1]:
                    array[j], array[j + 1] = array[j + 1], array[j]
        return array

### AICL DATASET: sorting/insertion_sort.aicl
=== SPEC ===
# AICL Example: Insertion Sort
# AX sub-language — compiles to real code.

Goal:
Sort using insertion sort

Layer:
Core

Behavior Sort
    Input: array
    Output: array
    Action:
        for i in range(1, len(array)):
            key = array[i]
            j = i - 1
            while j >= 0 and array[j] > key:
                array[j + 1] = array[j]
                j = j - 1
            array[j + 1] = key
        return array

### AICL DATASET: sorting/selection_sort.aicl
=== SPEC ===
# AICL Example: Selection Sort
# AX sub-language — compiles to real code.

Goal:
Sort using selection sort

Layer:
Core

Behavior Sort
    Input: array
    Output: array
    Action:
        n = len(array)
        for i in range(0, n):
            min_idx = i
            for j in range(i + 1, n):
                if array[j] < array[min_idx]:
                    min_idx = j
            array[i], array[min_idx] = array[min_idx], array[i]
        return array

### AICL DATASET: sorting/quicksort_partition.aicl
=== SPEC ===
# AICL Example: Quicksort Partition
# AX sub-language — compiles to real code.

Goal:
Lomuto partition

Layer:
Core

Behavior Partition
    Input: array, low, high
    Output: pivot_index
    Action:
        pivot = array[high]
        i = low - 1
        for j in range(low, high):
            if array[j] < pivot:
                i = i + 1
                array[i], array[j] = array[j], array[i]
        array[i + 1], array[high] = array[high], array[i + 1]
        return i + 1

### AICL DATASET: sorting/merge_arrays.aicl
=== SPEC ===
# AICL Example: Merge Sorted Arrays
# AX sub-language — compiles to real code.

Goal:
Merge two sorted arrays

Layer:
Core

Behavior Merge
    Input: a, b
    Output: result
    Action:
        result = []
        i = 0
        j = 0
        while i < len(a) and j < len(b):
            if a[i] <= b[j]:
                result.append(a[i])
                i = i + 1
            else:
                result.append(b[j])
                j = j + 1
        while i < len(a):
            result.append(a[i])
            i = i + 1
        while j < len(b):
            result.append(b[j])
            j = j + 1
        return result

### AICL DATASET: sorting/counting_sort.aicl
=== SPEC ===
# AICL Example: Counting Sort
# AX sub-language — compiles to real code.

Goal:
Sort with counting

Layer:
Core

Behavior Sort
    Input: array, max_val
    Output: result
    Action:
        count = []
        for i in range(0, max_val + 1):
            count.append(0)
        for i in range(0, len(array)):
            count[array[i]] = count[array[i]] + 1
        result = []
        for i in range(0, max_val + 1):
            for j in range(0, count[i]):
                result.append(i)
        return result

### AICL DATASET: searching/linear_search.aicl
=== SPEC ===
# AICL Example: Linear Search
# AX sub-language — compiles to real code.

Goal:
Find target

Risk:
Not found
Recovery:
Return -1

Layer:
Core

Behavior Search
    Input: array, target
    Output: index
    Action:
        i = 0
        while i < len(array):
            if array[i] == target:
                return i
            i = i + 1
        return -1

### AICL DATASET: searching/binary_search.aicl
=== SPEC ===
# AICL Example: Binary Search
# AX sub-language — compiles to real code.

Goal:
Search sorted array

Constraint:
Array must be sorted

Layer:
Core

Behavior Search
    Input: array, target
    Output: index
    Action:
        low = 0
        high = len(array) - 1
        while low <= high:
            mid = (low + high) // 2
            if array[mid] == target:
                return mid
            elif array[mid] < target:
                low = mid + 1
            else:
                high = mid - 1
        return -1

