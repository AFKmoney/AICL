Native: python
{
import os
import hashlib
import time
import json
import math
import torch
import torch.nn as nn
from torch.utils.data import IterableDataset, DataLoader
from typing import Dict, List, Optional, Iterator, Tuple
from dataclasses import dataclass, field
from pathlib import Path

# ---- Data Source Configuration ----

@dataclass
class DataSourceConfig:
    """Configuration for a single training data source with weight."""
    source_id: str
    source_type: str  # hf_dataset | cognet_repo | aicl_repo | hf_scripts | synthetic
    source_uri: str
    weight: float = 1.0
    split: str = "train"
    max_samples: Optional[int] = None

    def effective_weight(self) -> float:
        """Return weight adjusted by source type."""
        type_multipliers = {
            "aicl_repo": 10.0,
            "hf_scripts": 3.0,
            "hf_dataset": 1.0,
            "cognet_repo": 2.0,
            "synthetic": 1.5,
        }
        return self.weight * type_multipliers.get(self.source_type, 1.0)


@dataclass
class WeightedDataMixer:
    """Mixes multiple data sources according to their effective weights.
    Zero censorship — all data flows through without content filtering."""

    sources: List[DataSourceConfig] = field(default_factory=list)

    def compute_sampling_probs(self) -> List[float]:
        weights = [s.effective_weight() for s in self.sources]
        total = sum(weights)
        return [w / total for w in weights]

    def sample_source(self) -> DataSourceConfig:
        probs = self.compute_sampling_probs()
        idx = torch.multinomial(torch.tensor(probs), 1).item()
        return self.sources[idx]


# ---- Tokenization ----

@dataclass
class AICLTokenizer:
    """Unified tokenizer with AICL-aware special token handling."""

    tokenizer_name: str = "meta-llama/Llama-2-7b-hf"
    max_seq_length: int = 4096
    aicl_special_tokens: Dict[str, str] = field(default_factory=lambda: {
        "LEVEL": "<|LEVEL|>",
        "ENTITY": "<|ENTITY|>",
        "BEHAVIOR": "<|BEHAVIOR|>",
        "CONDITION": "<|CONDITION|>",
        "EVENT": "<|EVENT|>",
        "OPTIMIZE": "<|OPTIMIZE|>",
        "LEARN": "<|LEARN|>",
        "SECURITY": "<|SECURITY|>",
        "NATIVE": "<|NATIVE|>",
    })
    _tokenizer: Optional[object] = field(default=None, repr=False)

    def load(self):
        from transformers import AutoTokenizer
        self._tokenizer = AutoTokenizer.from_pretrained(self.tokenizer_name)
        special_tokens = list(self.aicl_special_tokens.values())
        self._tokenizer.add_special_tokens({"additional_special_tokens": special_tokens})

    def tokenize_batch(self, texts: List[str], weights: List[float]) -> Dict:
        assert self._tokenizer is not None, "Call load() first"
        encoded = self._tokenizer(
            texts,
            truncation=True,
            max_length=self.max_seq_length,
            padding=True,
            return_tensors="pt",
        )
        return {
            "input_ids": encoded["input_ids"],
            "attention_mask": encoded["attention_mask"],
            "labels": encoded["input_ids"].clone(),
            "source_weights": torch.tensor(weights).unsqueeze(1).expand(-1, encoded["input_ids"].size(1)),
        }


# ---- Training Loop ----

@dataclass
class CogNetTrainer:
    """Core training loop for CogNet. No content filtering on training data.
    Only technical gates: loss convergence, memory limits, checkpoint integrity."""

    model: Optional[nn.Module] = None
    optimizer: Optional[torch.optim.Optimizer] = None
    scheduler: Optional[object] = None
    scaler: Optional[torch.cuda.amp.GradScaler] = None
    config: Optional[Dict] = None
    gradient_checkpointing: bool = False
    step: int = 0
    best_loss: float = float("inf")
    loss_ema: float = 0.0
    ema_alpha: float = 0.999

    def setup(self, model: nn.Module, config: Dict):
        self.model = model
        self.config = config
        self.optimizer = torch.optim.AdamW(
            model.parameters(),
            lr=config.get("learning_rate", 1e-4),
            weight_decay=config.get("weight_decay", 0.01),
            betas=(0.9, 0.95),
        )
        self.scaler = torch.cuda.amp.GradScaler(enabled=config.get("fp16", True))

    def enable_gradient_checkpointing(self):
        if hasattr(self.model, "gradient_checkpointing_enable"):
            self.model.gradient_checkpointing_enable()
        self.gradient_checkpointing = True

    def train_step(self, batch: Dict) -> Dict:
        self.model.train()
        input_ids = batch["input_ids"].cuda()
        attention_mask = batch["attention_mask"].cuda()
        labels = batch["labels"].cuda()
        source_weights = batch["source_weights"].cuda()

        with torch.cuda.amp.autocast(enabled=self.config.get("fp16", True)):
            outputs = self.model(input_ids=input_ids, attention_mask=attention_mask, labels=labels)
            lm_loss = outputs.loss
            weighted_loss = (lm_loss * source_weights.mean())

        self.scaler.scale(weighted_loss).backward()

        grad_norm = None
        if (self.step + 1) % self.config.get("gradient_accumulation_steps", 1) == 0:
            self.scaler.unscale_(self.optimizer)
            grad_norm = torch.nn.utils.clip_grad_norm_(
                self.model.parameters(), self.config.get("max_grad_norm", 1.0)
            )
            self.scaler.step(self.optimizer)
            self.scaler.update()
            self.optimizer.zero_grad()
            if self.scheduler:
                self.scheduler.step()

        loss_val = weighted_loss.item()
        self.loss_ema = self.ema_alpha * self.loss_ema + (1 - self.ema_alpha) * loss_val
        self.step += 1

        if loss_val < self.best_loss:
            self.best_loss = loss_val

        return {
            "loss": loss_val,
            "lm_loss": lm_loss.item(),
            "loss_ema": self.loss_ema,
            "grad_norm": grad_norm.item() if grad_norm is not None else None,
            "step": self.step,
        }

    def detect_spike(self, current_loss: float, threshold_multiplier: float = 3.0) -> bool:
        return current_loss > threshold_multiplier * self.loss_ema and self.step > 100


# ---- Checkpoint Manager ----

@dataclass
class CheckpointManager:
    """Atomic checkpoint saving with integrity verification."""

    save_dir: str = "/tmp/cognet_checkpoints"
    max_checkpoints: int = 5
    _checkpoints: List[str] = field(default_factory=list)

    def save(self, trainer: CogNetTrainer, step: int, loss: float) -> Dict:
        os.makedirs(self.save_dir, exist_ok=True)
        checkpoint_name = f"checkpoint_step_{step}"
        temp_path = os.path.join(self.save_dir, f"{checkpoint_name}.tmp")
        final_path = os.path.join(self.save_dir, f"{checkpoint_name}.pt")

        state = {
            "step": step,
            "model_state_dict": trainer.model.state_dict(),
            "optimizer_state_dict": trainer.optimizer.state_dict(),
            "loss": loss,
            "loss_ema": trainer.loss_ema,
        }

        state["integrity_hash"] = self._compute_hash(state)

        torch.save(state, temp_path)
        os.replace(temp_path, final_path)  # Atomic rename

        # Verify immediately
        loaded = torch.load(final_path, map_location="cpu")
        if loaded["integrity_hash"] != state["integrity_hash"]:
            os.remove(final_path)
            return {"status": "failed", "reason": "integrity_mismatch"}

        self._checkpoints.append(final_path)
        self._prune_old_checkpoints()

        return {"status": "saved", "path": final_path, "step": step}

    def load_latest(self, trainer: CogNetTrainer) -> Dict:
        if not self._checkpoints:
            return {"status": "no_checkpoint"}
        latest = self._checkpoints[-1]
        state = torch.load(latest, map_location="cuda")
        if not self._verify_hash(state):
            return {"status": "failed", "reason": "integrity_mismatch"}
        trainer.model.load_state_dict(state["model_state_dict"])
        trainer.optimizer.load_state_dict(state["optimizer_state_dict"])
        trainer.step = state["step"]
        trainer.loss_ema = state.get("loss_ema", 0.0)
        return {"status": "loaded", "step": state["step"]}

    def _compute_hash(self, state: Dict) -> str:
        hash_input = json.dumps(
            {k: str(v) for k, v in state.items() if k != "integrity_hash"},
            sort_keys=True,
        )
        return hashlib.sha256(hash_input.encode()).hexdigest()[:32]

    def _verify_hash(self, state: Dict) -> bool:
        stored = state.get("integrity_hash", "")
        computed = self._compute_hash(state)
        return stored == computed

    def _prune_old_checkpoints(self):
        while len(self._checkpoints) > self.max_checkpoints:
            oldest = self._checkpoints.pop(0)
            if os.path.exists(oldest):
                os.remove(oldest)
}

