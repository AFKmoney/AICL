# AICL Example: Key Management System
# Enterprise key management system with HSM integration, automated key rotation,
# key escrow, hierarchical derivation, comprehensive audit logging, and compliance reporting

Goal Build an enterprise-grade key management system with FIPS 140-2 HSM integration, automated key lifecycle management including rotation and derivation, secure key escrow with threshold recovery, comprehensive audit trail, and regulatory compliance reporting

Constraint All cryptographic keys must be generated within FIPS 140-2 Level 3 validated HSM boundaries
Constraint Key rotation must occur automatically at intervals defined by key classification policy
Constraint Key material must never exist in plaintext outside HSM or secure enclave boundary
Constraint All key operations must produce immutable audit log entries within 1 second
Constraint Key escrow recovery must require minimum 3-of-5 threshold authorization

Risk HSM hardware failure renders encrypted data permanently inaccessible
Recovery Maintain geographically distributed HSM cluster with automatic failover, verify backup HSM key synchronization, implement emergency key export procedure with multi-party authorization
Risk Key rotation gap exposes data encrypted with deprecated or compromised keys
Recovery Enforce overlapping validity periods during rotation, re-encrypt all data with new key before deprecating old key, and implement rotation deadline enforcement with automated escalation
Risk Insider threat extracts key material through administrative access abuse
Recovery Implement dual-control administrative operations, enforce separation of duties, log all privileged access with real-time alerting, and require hardware token authentication for key operations
Risk Key escrow abuse enables unauthorized data decryption by escrow agents
Recovery Implement threshold decryption requiring multiple escrow agents, audit all escrow access with tamper-evident logging, and enforce time-bound escrow access with explicit justification
Risk Compliance violation due to inadequate key lifecycle documentation
Recovery Automate compliance report generation from audit logs, enforce policy-driven key creation with mandatory metadata, and implement continuous compliance monitoring with violation alerts

Layer KeyManagement
    SubLayer: HSMLayer
        # Hardware Security Module integration and key generation
    SubLayer: KeyLifecycle
        # Key creation, activation, rotation, deactivation, destruction
    SubLayer: KeyDerivation
        # Hierarchical key derivation and key hierarchy management
    SubLayer: KeyEscrow
        # Threshold escrow, recovery procedures, and access control
    SubLayer: AuditCompliance
        # Immutable audit logging, compliance reporting, evidence collection

Validation Key generation must produce keys meeting minimum entropy requirements for declared algorithm
Validation Key rotation must re-encrypt all associated data before marking old key as deprecated
Validation HSM operations must authenticate with both operator credential and hardware token
Validation Escrow access must produce verifiable authorization record with threshold signatures
Validation Audit log entries must be tamper-evident with hash chain integrity verification
Validation Key hierarchy must enforce that parent key derivation requires parent key activation
Validation Destroyed keys must have cryptographic proof of secure erasure from all storage media

Entity CryptoKey
    key_id: string
    algorithm: string
    key_size: integer
    key_type: string
    classification: string
    hsm_slot: integer
    creation_date: datetime
    activation_date: datetime
    expiration_date: datetime
    rotation_policy: string
    status: string
    fingerprint: string

Entity KeyHierarchy
    hierarchy_id: string
    master_key_id: string
    parent_key_id: string
    child_key_ids: list
    derivation_path: string
    derivation_algorithm: string
    depth: integer
    purpose: string
    created_date: datetime

Entity RotationPolicy
    policy_id: string
    name: string
    key_classification: string
    rotation_interval_days: integer
    overlap_period_days: integer
    auto_rotate: boolean
    re_encrypt_data: boolean
    notification_days_before: integer
    approval_required: boolean
    escalation_contact: string

Entity EscrowShare
    share_id: string
    key_id: string
    agent_id: string
    share_data: bytes
    threshold: integer
    total_shares: integer
    created_date: datetime
    last_accessed: datetime
    access_reason: string
    is_verified: boolean

Entity AuditEntry
    entry_id: string
    timestamp: datetime
    operation: string
    key_id: string
    operator_id: string
    source_ip: string
    result: string
    details: dict
    previous_hash: string
    entry_hash: string
    correlation_id: string

Entity HSMDevice
    device_id: string
    manufacturer: string
    model: string
    firmware_version: string
    fips_level: integer
    slot_count: integer
    active_slots: integer
    total_operations: integer
    last_health_check: datetime
    cluster_node: string
    status: string

Entity ComplianceReport
    report_id: string
    report_type: string
    period_start: datetime
    period_end: datetime
    total_keys: integer
    active_keys: integer
    rotated_keys: integer
    expired_keys: integer
    compliance_violations: integer
    escrow_access_count: integer
    generated_date: datetime
    certifier: string

Behavior GenerateKey
    Input:
        algorithm: string
        key_size: integer
        classification: string
        hsm_device: HSMDevice
        purpose: string
    Output:
        key: CryptoKey
        key_fingerprint: string
    Action:
        Authenticate operator to HSM with dual-factor credential
        Select available HSM slot for key generation
        Generate key material within HSM boundary using approved RNG
        Compute key fingerprint for identification
        Set key activation and expiration based on rotation policy
        Record key metadata in management database
        Create audit entry for generation operation
        Return key reference with fingerprint

Behavior RotateKey
    Input:
        current_key: CryptoKey
        rotation_policy: RotationPolicy
        re_encrypt: boolean
    Output:
        new_key: CryptoKey
        re_encryption_result: dict
    Action:
        Generate new key following same algorithm and classification
        Activate new key with overlap period alongside current key
        If re_encrypt flag set, re-encrypt all data referencing current key
        Update key hierarchy to point children to new key
        Mark current key as deprecated after overlap period
        Schedule current key destruction per retention policy
        Generate audit trail for entire rotation process
        Notify all dependent services of key rotation

Behavior DeriveChildKey
    Input:
        parent_key: CryptoKey
        derivation_path: string
        context: string
        algorithm: string
    Output:
        child_key: CryptoKey
        derivation_proof: string
    Action:
        Verify parent key is in active status
        Validate derivation path follows hierarchy conventions
        Execute key derivation within HSM using HKDF or similar
        Bind derived key to context and purpose metadata
        Register child key in hierarchy with parent reference
        Generate derivation proof for audit verification
        Record derivation operation in audit log
        Return child key with derivation metadata

Behavior AccessEscrow
    Input:
        key_id: string
        requesting_agents: list
        justification: string
        threshold: integer
    Output:
        recovered_key_ref: string
        access_record: dict
    Action:
        Verify number of agents meets or exceeds threshold requirement
        Authenticate each agent with independent credentials
        Validate justification against escrow access policy
        Combine threshold shares to reconstruct key reference
        Grant time-limited access to recovered key
        Generate detailed audit entry for each participant
        Notify key owner and compliance officer of escrow access
        Return key reference with access record

Behavior DestroyKey
    Input:
        key_id: string
        authorization: list
        reason: string
    Output:
        destruction_certificate: dict
    Action:
        Verify destruction authorization from multiple approvers
        Execute secure key erasure within HSM boundary
        Overwrite key storage locations with verified zeroization
        Remove key metadata from active database
        Archive key reference for compliance retention period
        Generate cryptographic proof of destruction
        Create immutable audit entry with destruction evidence
        Return destruction certificate with verification

Behavior MonitorHSM
    Input:
        hsm_device: HSMDevice
        check_interval: integer
    Output:
        health_status: dict
        alerts: list
    Action:
        Verify HSM connectivity and authentication
        Check firmware integrity against known good hash
        Monitor slot utilization and available capacity
        Track operation count and performance metrics
        Verify cluster synchronization status
        Detect anomaly patterns in operation latency
        Generate health status report with alert conditions
        Trigger automatic failover if primary HSM unhealthy

Behavior GenerateComplianceReport
    Input:
        report_type: string
        period_start: datetime
        period_end: datetime
        standards: list
    Output:
        report: ComplianceReport
        violations: list
    Action:
        Aggregate key lifecycle events within reporting period
        Count keys by status, classification, and algorithm
        Identify rotation policy violations and overdue rotations
        Catalog escrow access events with justification review
        Validate audit log chain integrity for period
        Compare practices against declared compliance standards
        Generate violation list with remediation recommendations
        Return signed compliance report with evidence package

Condition:
    When key expiration date is within 30 days and no rotation scheduled
    Then emit rotation_urgent alert and auto-initiate rotation if policy allows

Condition:
    When HSM operation latency exceeds 2x baseline for 3 consecutive checks
    Then emit hsm_degradation_warning and prepare failover to backup HSM device

Condition:
    When escrow access attempt fails threshold verification 3 times
    Then lock escrow access, alert security team, and create incident record

Condition:
    When audit log hash chain breaks at any entry
    Then emit integrity_violation_critical alert, halt key operations, and initiate forensic investigation

Condition:
    When key derivation request exceeds maximum hierarchy depth of 8 levels
    Then reject derivation request and emit policy_violation with hierarchy depth limit explanation

Event:
    On key_generated
    Action: Record audit entry, update key inventory, check rotation policy compliance, notify dependent services

Event:
    On key_rotated
    Action: Trigger re-encryption workflow, update hierarchy references, emit rotation notification, schedule deprecation

Event:
    On key_destroyed
    Action: Archive destruction certificate, update inventory, verify zeroization, emit destruction confirmation

Event:
    On hsm_failover_activated
    Action: Verify backup HSM key synchronization, update routing, alert operations team, log failover details

Event:
    On escrow_accessed
    Action: Notify key owner, alert compliance team, record access justification, verify threshold participant identities

Parallel:
    HSM health monitoring across all cluster nodes
    Key rotation scheduling and automated execution
    Audit log chain integrity verification
    Compliance monitoring and violation detection

Optimize: Key rotation execution with zero downtime
    Priority: Minimize service disruption during rotation by ensuring overlap period coverage and parallel re-encryption

Optimize: HSM operation throughput for high-volume key operations
    Priority: Maximize operations per second through connection pooling and batch operation support

Optimize: Audit log storage and query performance
    Priority: Maintain sub-second query response for compliance reports while storing years of immutable audit data

Learn: Optimal rotation interval prediction
    Goal: Predict optimal key rotation intervals based on key usage patterns and threat landscape
    Adapt: Rotation policy parameters and schedule optimization
    Based: Key usage frequency, data sensitivity classification changes, cryptographic algorithm lifecycle, and threat intelligence

Learn: HSM capacity planning
    Goal: Forecast HSM resource requirements to prevent capacity-related failures
    Adapt: HSM scaling parameters and slot allocation strategy
    Based: Key creation rate trends, operation volume growth, and hardware performance degradation models

Learn: Anomalous access pattern detection
    Goal: Identify unusual key access patterns that may indicate compromise or insider threat
    Adapt: Access pattern anomaly scoring thresholds and alert criteria
    Based: Historical access patterns by operator, time-of-day distributions, and correlation with security events

Security:
    Encrypt: All key metadata in database using AES-256-GCM with per-record encryption keys
    Encrypt: HSM communication channels using mutually authenticated TLS with certificate pinning
    Protect: Key material against extraction using HSM boundary enforcement and memory locking
    Protect: Audit logs against tampering using hash chain with cryptographic timestamping
    Protect: Escrow shares against reconstruction below threshold using Shamir secret sharing with verifiable shares
    Protect: Administrative operations against unauthorized execution using dual-control authentication and hardware tokens

Native: go
    {
    import (
        "crypto/aes"
        "crypto/cipher"
        "crypto/rand"
        "crypto/sha256"
        "crypto/hmac"
        "encoding/hex"
        "time"
    )

    type KeyManager struct {
        hsmClient    HSMClient
        auditLogger  AuditLogger
        keyStore     KeyStore
    }

    func (km *KeyManager) GenerateKey(algorithm string, keySize int, classification string) (*CryptoKey, error) {
        keyBytes, err := km.hsmClient.GenerateRandom(keySize / 8)
        if err != nil {
            return nil, err
        }

        fingerprint := sha256.Sum256(keyBytes)
        key := &CryptoKey{
            KeyID:         generateUUID(),
            Algorithm:     algorithm,
            KeySize:       keySize,
            Classification: classification,
            Fingerprint:   hex.EncodeToString(fingerprint[:]),
            Status:        "active",
            CreationDate:  time.Now(),
        }

        km.auditLogger.Log(AuditEntry{
            Operation:  "GENERATE_KEY",
            KeyID:      key.KeyID,
            Result:     "success",
            Timestamp:  time.Now(),
        })

        return key, nil
    }

    func (km *KeyManager) RotateKey(currentKeyID string) (*CryptoKey, error) {
        current, err := km.keyStore.Get(currentKeyID)
        if err != nil {
            return nil, err
        }

        newKey, err := km.GenerateKey(current.Algorithm, current.KeySize, current.Classification)
        if err != nil {
            return nil, err
        }

        current.Status = "deprecated"
        km.keyStore.Update(current)

        return newKey, nil
    }

    func computeHKDF(ikm, salt, info []byte, length int) []byte {
        extractor := hmac.New(sha256.New, salt)
        extractor.Write(ikm)
        prk := extractor.Sum(nil)

        var okm []byte
        var prev []byte
        for len(okm) < length {
            expander := hmac.New(sha256.New, prk)
            expander.Write(prev)
            expander.Write(info)
            expander.Write([]byte{byte(len(okm)/32 + 1)})
            prev = expander.Sum(nil)
            okm = append(okm, prev...)
        }
        return okm[:length]
    }
    }
