# =============================================================================
# LEVEL 2 — Entities
# =============================================================================

Entity Flight
    flight_id: string
    airline_code: string
    flight_number: string
    origin: string
    destination: string
    departure_time: datetime
    arrival_time: datetime
    aircraft_type: string
    total_seats: integer
    available_seats: integer
    status: string
    gate: string

Entity Passenger
    passenger_id: string
    first_name: string
    last_name: string
    date_of_birth: datetime
    nationality: string
    passport_number: string
    loyalty_number: string
    loyalty_tier: string
    special_needs: string

Entity Booking
    booking_id: string
    passenger_id: string
    flight_id: string
    booking_class: string
    seat_number: string
    fare_paid: float
    currency: string
    booking_status: string
    payment_status: string
    booking_date: datetime
    cancellation_date: datetime

Entity Seat
    seat_id: string
    flight_id: string
    seat_number: string
    cabin_class: string
    position: string
    is_available: boolean
    extra_legroom: boolean
    price_modifier: float

Entity Baggage
    baggage_id: string
    booking_id: string
    passenger_id: string
    baggage_type: string
    weight_kg: float
    tag_number: string
    status: string
    checked_in_at: datetime

Entity LoyaltyAccount
    account_number: string
    passenger_id: string
    tier: string
    points_balance: integer
    lifetime_points: integer
    qualifying_flights: integer
    membership_year: integer
    status: string

Entity FareRule
    rule_id: string
    fare_class: string
    cancellation_fee: float
    change_fee: float
    refundable: boolean
    baggage_allowance: integer
    advance_purchase_days: integer
    min_stay_days: integer

# =============================================================================
# LEVEL 3 — Behaviors
# =============================================================================

Behavior SearchFlights

Input:
    origin destination date passengers cabin_class

Output:
    list

Action:
    query available flights and fares and return sorted by price and duration

Behavior CreateBooking

Input:
    Flight Passenger booking_class seat_number payment_method

Output:
    Booking

Action:
    reserve seat and create booking record and process payment atomically

Behavior SelectSeat

Input:
    Booking seat_number

Output:
    Seat

Action:
    verify seat availability and assign to booking and update cabin layout

Behavior CheckIn

Input:
    Booking Passenger baggage_info

Output:
    list

Action:
    validate booking and assign final seat and issue boarding pass and register baggage

Behavior CalculateFare

Input:
    Flight booking_class demand_factor days_before_departure

Output:
    float

Action:
    compute dynamic fare based on class demand and advance purchase rules

Behavior EarnLoyaltyPoints

Input:
    Booking fare_paid cabin_class loyalty_tier

Output:
    integer

Action:
    calculate earned points based on fare and tier multiplier and credit to account

Behavior ProcessRefund

Input:
    Booking cancellation_reason

Output:
    float

Action:
    apply fare rules and calculate refund amount and process payment reversal

Behavior UpdateFlightStatus

Input:
    Flight new_status estimated_delay

Action:
    update flight status and notify all booked passengers and trigger rebooking if needed

# =============================================================================
# LEVEL 4 — Conditions
# =============================================================================

Condition:

When flight is overbooked beyond voluntary bump threshold

Then deny additional bookings and offer voluntary rebooking with compensation

Condition:

When passenger check-in occurs after T-45 minutes before departure

Then reject check-in and redirect to airport counter and mark as late check-in

Condition:

When dynamic fare exceeds 3x the base fare for economy class

Then apply fare cap and flag for revenue management review

Condition:

When loyalty member qualifies for tier upgrade

Then automatically upgrade tier and issue new card and unlock benefits

Condition:

When flight delay exceeds 3 hours

Then trigger EU261 compensation eligibility check and notify affected passengers

Condition:

When passport expiry is within 6 months of travel date

Then flag booking for document verification and notify passenger to renew

# =============================================================================
# LEVEL 5 — Events
# =============================================================================

Event:

On booking confirmed

Action:
    send confirmation email and SMS and add to calendar and earn loyalty points

Event:

On flight status change

Action:
    notify all booked passengers and update departure boards and trigger rebooking if cancelled

Event:

On check-in window opens

Action:
    send check-in reminder to all passengers on flight and enable online check-in

Event:

On seat selection changed

Action:
    update cabin map and recalculate seat pricing and send updated boarding pass

Event:

On loyalty tier milestone reached

Action:
    upgrade tier status and grant milestone bonus points and send congratulations

Event:

On baggage scanned at checkpoint

Action:
    update baggage tracking status and notify passenger of baggage location

Event:

On refund processed

Action:
    credit payment method and adjust loyalty points and send refund confirmation

# =============================================================================
# LEVEL 6 — Concurrency
# =============================================================================

Parallel:

Flight Search Service
Booking Engine
Pricing Engine
Check-in Service

Parallel:

Loyalty Points Processor
Baggage Tracking
Notification Service
Revenue Management Sync

# =============================================================================
# LEVEL 7 — Optimization
# =============================================================================

Optimize:
Flight search response latency

Optimize:
Seat allocation revenue maximization

Optimize:
Booking conversion rate

Priority:
Booking atomicity over search speed

# =============================================================================
# LEVEL 8 — Learning
# =============================================================================

Learn:

Demand forecasting by route and season

Goal:
    predict booking patterns to optimize pricing and capacity allocation

Learn:

No-show probability per booking

Goal:
    optimize overbooking strategy while minimizing denied boarding incidents

Adapt:

Dynamic fare multipliers

Based on:
    booking pace historical demand and competitor pricing

Adapt:

Seat allocation between cabins

Based on:
    real-time demand by cabin class and historical upgrade patterns

# =============================================================================
# LEVEL 9 — Security
# =============================================================================

Security:

Encrypt:
    passenger personal and passport data

Encrypt:
    payment card information

Encrypt:
    loyalty account credentials

Protect:
    fare calculation algorithms from manipulation

Protect:
    booking records from unauthorized modifications

Protect:
    loyalty point balances from fraud

Protect:
    flight operational data and crew information

# =============================================================================
# LEVEL 10 — Native Code
# =============================================================================

Native: python
{
import hashlib
import time
from dataclasses import dataclass
from enum import Enum
from typing import Optional

class CabinClass(Enum):
    ECONOMY = "Y"
    PREMIUM_ECONOMY = "W"
    BUSINESS = "C"
    FIRST = "F"

class BookingStatus(Enum):
    CONFIRMED = "CONFIRMED"
    CANCELLED = "CANCELLED"
    CHECKED_IN = "CHECKED_IN"
    BOARDED = "BOARDED"

@dataclass
class FareQuote:
    base_fare: float
    taxes: float
    fees: float
    total: float
    currency: str = "USD"

class DynamicPricer:
    TIER_MULTIPLIERS = {
        CabinClass.ECONOMY: 1.0,
        CabinClass.PREMIUM_ECONOMY: 1.8,
        CabinClass.BUSINESS: 3.5,
        CabinClass.FIRST: 6.0,
    }

    def __init__(self, base_fare: float):
        self.base_fare = base_fare

    def calculate(self, cabin: CabinClass, demand_factor: float,
                  days_before: int) -> FareQuote:
        tier_mult = self.TIER_MULTIPLIERS[cabin]
        advance_discount = max(0.7, min(1.0, days_before / 90))
        demand_surcharge = max(1.0, demand_factor)
        base = self.base_fare * tier_mult * advance_discount * demand_surcharge
        taxes = base * 0.12
        fees = base * 0.05
        return FareQuote(
            base_fare=round(base, 2),
            taxes=round(taxes, 2),
            fees=round(fees, 2),
            total=round(base + taxes + fees, 2)
        )

def generate_booking_ref(airline_code: str) -> str:
    ts = str(int(time.time() * 1000))[-8:]
    h = hashlib.sha256(f"{airline_code}{ts}".encode()).hexdigest()[:4].upper()
    return f"{airline_code}{ts}{h}"

def calculate_loyalty_points(fare: float, tier: str) -> int:
    multipliers = {"basic": 1, "silver": 1.5, "gold": 2, "platinum": 3}
    mult = multipliers.get(tier, 1)
    return int(fare * mult)
}

# =============================================================================
# Validations
# =============================================================================

Validation:
Flight search returns accurate results within 3 seconds

Validation:
Bookings are created atomically with seat reservation and payment

Validation:
Dynamic pricing reflects demand and advance purchase rules

Validation:
Online check-in opens 24 hours before departure and closes 45 minutes before

Validation:
Loyalty points are earned and redeemed correctly across partner airlines

Validation:
Overbooking is managed within acceptable denied boarding rates

Validation:
Refunds are processed according to fare rules

Validation:
Passenger notifications are delivered for all flight status changes

Validation:
Baggage tracking provides real-time status to passengers

Validation:
System handles 20000 concurrent booking sessions without degradation
