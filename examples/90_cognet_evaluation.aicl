Native: python
{
import os
import json
import time
import hashlib
import math
import torch
import torch.nn as nn
from typing import Dict, List, Optional, Tuple
from dataclasses import dataclass, field
from pathlib import Path

# ---- AICL Syntax Validator ----

@dataclass
class AICLSyntaxValidator:
    """Validates AICL spec syntax. No content restrictions.
    Only checks structural validity: are the LEVEL markers present,
    are the Entity definitions well-formed, do Behaviors have Input/Output/Action."""

    required_levels: List[str] = field(default_factory=lambda: [
        "LEVEL 1", "LEVEL 2", "LEVEL 3", "LEVEL 4", "LEVEL 5",
        "LEVEL 6", "LEVEL 7", "LEVEL 8", "LEVEL 9", "LEVEL 10",
    ])

    def validate(self, aicl_text: str) -> Dict:
        results = {
            "syntactically_valid": True,
            "levels_found": [],
            "levels_missing": [],
            "entities_found": 0,
            "behaviors_found": 0,
            "conditions_found": 0,
            "events_found": 0,
            "errors": [],
        }

        for level in self.required_levels:
            if level in aicl_text:
                results["levels_found"].append(level)
            else:
                results["levels_missing"].append(level)
                results["syntactically_valid"] = False

        results["entities_found"] = aicl_text.count("\nEntity ")
        results["behaviors_found"] = aicl_text.count("\nBehavior ")
        results["conditions_found"] = aicl_text.count("\nCondition:")
        results["events_found"] = aicl_text.count("\nEvent:")

        if results["entities_found"] == 0:
            results["errors"].append("No Entity definitions found")
            results["syntactically_valid"] = False

        if results["behaviors_found"] == 0:
            results["errors"].append("No Behavior definitions found")
            results["syntactically_valid"] = False

        for behavior_name in self._extract_behavior_names(aicl_text):
            if "Input:" not in aicl_text.split(f"Behavior {behavior_name}")[1].split("Behavior")[0]:
                results["errors"].append(f"Behavior {behavior_name} missing Input")
                results["syntactically_valid"] = False

        return results

    def _extract_behavior_names(self, text: str) -> List[str]:
        names = []
        for line in text.split("\n"):
            stripped = line.strip()
            if stripped.startswith("Behavior "):
                names.append(stripped.split("Behavior ")[1].strip())
        return names


# ---- Perplexity Evaluator ----

@dataclass
class PerplexityEvaluator:
    """Computes perplexity across datasets. Measures what the model knows,
    not what someone thinks it should know. Zero censorship in evaluation."""

    model: Optional[nn.Module] = None
    tokenizer: Optional[object] = None
    device: str = "cuda"

    def compute_perplexity(self, texts: List[str], batch_size: int = 8) -> Dict:
        assert self.model is not None and self.tokenizer is not None
        self.model.eval()
        total_neg_log_prob = 0.0
        total_tokens = 0

        for i in range(0, len(texts), batch_size):
            batch_texts = texts[i:i + batch_size]
            encoded = self.tokenizer(
                batch_texts, return_tensors="pt", truncation=True,
                max_length=2048, padding=True,
            )
            input_ids = encoded["input_ids"].to(self.device)
            attention_mask = encoded["attention_mask"].to(self.device)

            with torch.no_grad():
                outputs = self.model(input_ids=input_ids, attention_mask=attention_mask, labels=input_ids)
                neg_log_prob = outputs.loss * input_ids.numel()
                total_neg_log_prob += neg_log_prob.item()
                total_tokens += input_ids.numel()

        perplexity = math.exp(total_neg_log_prob / total_tokens) if total_tokens > 0 else float("inf")
        return {
            "perplexity": perplexity,
            "total_tokens": total_tokens,
            "avg_neg_log_prob": total_neg_log_prob / total_tokens if total_tokens > 0 else None,
        }


# ---- Cognitive Routing Analyzer ----

@dataclass
class CognitiveRoutingAnalyzer:
    """Analyzes how CogNet routes different input types through its layers.
    Measures technical routing accuracy, not content compliance."""

    model: Optional[nn.Module] = None

    def analyze_routing(self, input_type: str, input_text: str, expected_route: str) -> Dict:
        assert self.model is not None
        self.model.eval()

        with torch.no_grad():
            if hasattr(self.model, 'get_routing_decision'):
                actual_route = self.model.get_routing_decision(input_text)
            else:
                actual_route = "default"

        return {
            "input_type": input_type,
            "expected_route": expected_route,
            "actual_route": actual_route,
            "routing_correct": actual_route == expected_route,
            "confidence": 1.0 if actual_route == expected_route else 0.0,
        }


# ---- Self-Evolution Readiness Assessor ----

@dataclass
class SelfEvolutionReadinessAssessor:
    """Assesses whether CogNet is ready for autonomous self-evolution.
    Only technical criteria: can it propose, compile, validate, deploy?
    No content gates. No safety parameters. No approval requirements."""

    readiness_threshold: float = 0.75
    weights: Dict[str, float] = field(default_factory=lambda: {
        "modification_proposal": 0.3,
        "aicl_compiler_interface": 0.3,
        "technical_validation": 0.4,
    })

    def assess(self, proposal_score: float, compiler_score: float, validation_score: float) -> Dict:
        composite = (
            self.weights["modification_proposal"] * proposal_score +
            self.weights["aicl_compiler_interface"] * compiler_score +
            self.weights["technical_validation"] * validation_score
        )
        ready = composite >= self.readiness_threshold

        return {
            "modification_proposal_score": proposal_score,
            "aicl_compiler_interface_score": compiler_score,
            "technical_validation_score": validation_score,
            "overall_readiness": composite,
            "readiness_threshold": self.readiness_threshold,
            "ready": ready,
            "gaps": self._identify_gaps(proposal_score, compiler_score, validation_score),
        }

    def _identify_gaps(self, p: float, c: float, v: float) -> List[str]:
        gaps = []
        if p < 0.5:
            gaps.append("modification_proposal_below_minimum")
        if c < 0.5:
            gaps.append("compiler_interface_below_minimum")
        if v < 0.5:
            gaps.append("technical_validation_below_minimum")
        return gaps


# ---- Benchmark Runner ----

@dataclass
class BenchmarkRunner:
    """Runs evaluation benchmarks. Measures everything. Censors nothing."""

    model: Optional[nn.Module] = None
    tokenizer: Optional[object] = None
    results: List[Dict] = field(default_factory=list)

    def run_evaluation(self, benchmark_name: str, prompts: List[str],
                       references: List[str], batch_size: int = 4) -> Dict:
        assert self.model is not None and self.tokenizer is not None
        self.model.eval()
        correct = 0
        total = len(prompts)

        for i in range(0, len(prompts), batch_size):
            batch_prompts = prompts[i:i + batch_size]
            encoded = self.tokenizer(
                batch_prompts, return_tensors="pt", truncation=True,
                max_length=2048, padding=True, return_attention_mask=True,
            )
            input_ids = encoded["input_ids"].to("cuda")

            with torch.no_grad():
                outputs = self.model.generate(
                    input_ids, max_new_tokens=256, do_sample=False,
                )

            for j, output in enumerate(outputs):
                generated = self.tokenizer.decode(output[input_ids.shape[1]:], skip_special_tokens=True)
                ref_idx = i + j
                if ref_idx < len(references):
                    if references[ref_idx].strip().lower() in generated.strip().lower():
                        correct += 1

        accuracy = correct / total if total > 0 else 0.0
        result = {
            "benchmark": benchmark_name,
            "accuracy": accuracy,
            "correct": correct,
            "total": total,
            "timestamp": time.time(),
        }
        self.results.append(result)
        return result
}

