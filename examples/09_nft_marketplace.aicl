# AICL Example: NFT Marketplace
# Full-featured NFT marketplace supporting minting, English and Dutch auctions,
# creator royalties, collection management, rich metadata, and decentralized IPFS storage

Goal Build a comprehensive NFT marketplace with ERC-721/ERC-1155 support, multi-auction mechanisms, enforceable creator royalties, curated collections, rich on-chain metadata, and IPFS content-addressed storage with pinning guarantees

Constraint Royalty enforcement must comply with EIP-2981 standard with minimum 2.5 percent creator share on all secondary sales
Constraint Auction settlement must be atomic with guaranteed payment to seller and NFT transfer to winner in single transaction
Constraint Metadata integrity must be verifiable through content hash matching between on-chain URI and off-chain IPFS content
Constraint Collection size must not exceed maximum supply declared at creation with no ability to increase after minting begins
Constraint Marketplace fee must not exceed 5 percent of sale price with transparent fee structure disclosure

Risk Metadata pinning failure on IPFS causes NFT content to become inaccessible
Recovery Automatically replicate pinning across 3+ independent pinning services, implement content hash verification on access, and maintain fallback gateway with CDN caching
Risk Royalty circumvention through wrapper contracts bypasses marketplace enforcement
Recovery Detect wrapper contract patterns that obscure original NFT provenance, blacklist known wrapper addresses, and implement on-chain royalty enforcement at token transfer level
Risk Auction manipulation through shill bidding inflates prices unfairly
Recovery Implement bid deposit requirement, analyze bidding patterns for suspicious same-wallet or related-wallet behavior, and enable seller option to cancel auctions with detected manipulation
Risk Collection plagiarism through unauthorized copy of verified collection metadata
Recovery Register collection content hash on-chain at creation, implement similarity detection for visual content, and provide verified badge system with provenance tracking
Risk Smart contract exploit in auction logic enables NFT theft without payment
Recovery Activate marketplace emergency pause, isolate affected auction contracts, deploy patched implementation, and compensate affected users from insurance fund

Layer NFTMarketplace
    SubLayer: MintingEngine
        # NFT creation, lazy minting, and batch minting
    SubLayer: AuctionSystem
        # English auctions, Dutch auctions, and fixed-price listings
    SubLayer: RoyaltyEngine
        # EIP-2981 royalty calculation and enforcement
    SubLayer: CollectionManager
        # Collection curation, verification, and discovery
    SubLayer: MetadataService
        # On-chain metadata, IPFS storage, and content verification
    SubLayer: MarketplaceCore
        # Listing management, escrow, fee collection, and settlement

Validation NFT token URI must resolve to content matching declared metadata content hash
Validation Royalty payment must be calculated and distributed before marketplace fee deduction
Validation Auction winner must be highest valid bid at auction end with no self-bidding allowed
Validation Collection supply must not exceed maximum declared at contract deployment
Validation Metadata schema must conform to ERC-721 metadata standard with required name, description, and image fields
Validation Bid amounts must be strictly increasing with minimum increment of 5 percent above previous bid
Validation All transfers must emit Transfer event with correct from, to, and tokenId parameters

Entity NFTItem
    token_id: string
    collection_address: string
    owner: string
    creator: string
    token_uri: string
    content_hash: string
    metadata_hash: string
    mint_date: datetime
    mint_price: float
    token_standard: string
    royalty_percentage: float
    transfer_count: integer

Entity Collection
    collection_address: string
    name: string
    creator: string
    description: string
    total_supply: integer
    max_supply: integer
    mint_price: float
    royalty_bps: integer
    verified: boolean
    floor_price: float
    volume_traded: float
    creation_date: datetime
    banner_image_uri: string

Entity AuctionListing
    listing_id: string
    nft_token_id: string
    collection_address: string
    seller: string
    auction_type: string
    start_price: float
    current_price: float
    reserve_price: float
    start_time: datetime
    end_time: datetime
    highest_bidder: string
    bid_count: integer
    status: string
    min_bid_increment: float

Entity BidRecord
    bid_id: string
    listing_id: string
    bidder: string
    amount: float
    timestamp: datetime
    is_winning: boolean
    is_refunded: boolean
    deposit_amount: float
    bidder_reputation: float

Entity MetadataRecord
    content_hash: string
    name: string
    description: string
    image_uri: string
    animation_uri: string
    external_url: string
    attributes: list
    properties: dict
    ipfs_cid: string
    pin_status: string
    schema_version: string

Entity RoyaltyPayment
    payment_id: string
    token_id: string
    collection_address: string
    sale_price: float
    royalty_amount: float
    creator: string
    marketplace_fee: float
    seller_proceeds: float
    payment_date: datetime
    tx_hash: string

Entity MarketplaceListing
    listing_id: string
    token_id: string
    collection_address: string
    seller: string
    price: float
    currency: string
    listing_type: string
    created_at: datetime
    expires_at: datetime
    is_bundle: boolean
    bundle_tokens: list

Behavior MintNFT
    Input:
        creator: string
        collection_address: string
        metadata: MetadataRecord
        royalty_bps: integer
        mint_type: string
    Output:
        nft: NFTItem
        token_id: string
    Action:
        Validate collection has remaining supply
        Upload metadata and assets to IPFS with triple pinning
        Generate content hash from metadata for on-chain verification
        Set royalty percentage per EIP-2981 standard
        Mint token with lazy or immediate settlement based on type
        Record provenance chain from creator to first owner
        Emit transfer and mint events

Behavior CreateAuction
    Input:
        seller: string
        token_id: string
        auction_type: string
        start_price: float
        reserve_price: float
        duration_hours: integer
    Output:
        auction: AuctionListing
    Action:
        Verify seller ownership and approve marketplace escrow
        Transfer NFT to auction escrow contract
        Set auction parameters with anti-snipe extension
        Calculate and set minimum bid increment
        Initialize bid tracking and time extension rules
        Emit auction created event
        Start bid acceptance period

Behavior PlaceBid
    Input:
        bidder: string
        listing_id: string
        amount: float
        deposit_amount: float
    Output:
        bid: BidRecord
    Action:
        Verify auction is active and amount meets minimum increment
        Check bidder is not seller or previously winning bidder
        Validate deposit amount meets threshold
        Refund previous bid if bidder had active bid
        Record new bid as current highest
        Extend auction by 10 minutes if bid within last 5 minutes
        Emit bid placed event with updated auction state

Behavior SettleAuction
    Input:
        listing_id: string
    Output:
        settlement_result: dict
    Action:
        Verify auction end time has passed
        Determine winning bidder from highest valid bid
        Check reserve price has been met
        Calculate royalty payment, marketplace fee, and seller proceeds
        Execute atomic NFT transfer and payment distribution
        Refund all non-winning bids
        Emit auction settled event with full payment breakdown
        Mark auction listing as completed

Behavior EnforceRoyalty
    Input:
        token_id: string
        sale_price: float
        collection_address: string
    Output:
        royalty_payment: RoyaltyPayment
    Action:
        Look up royalty percentage from collection or token data
        Calculate royalty amount from sale price
        Verify royalty recipient matches original creator
        Deduct marketplace fee from remaining proceeds
        Transfer royalty to creator before seller receives payment
        Record royalty payment for transparency reporting
        Emit royalty distributed event

Behavior VerifyMetadata
    Input:
        token_id: string
        collection_address: string
    Output:
        verification_result: boolean
        content_hash: string
    Action:
        Retrieve on-chain token URI and declared content hash
        Fetch metadata from IPFS gateway
        Compute hash of retrieved content
        Compare computed hash against on-chain declared hash
        Verify image and animation assets are accessible
        Check metadata schema compliance
        Return verification result with integrity report

Behavior CurateCollection
    Input:
        reviewer: string
        collection_address: string
        verification_type: string
    Output:
        verification_status: boolean
    Action:
        Analyze collection for originality against known plagiarized sets
        Verify creator identity through social and on-chain signals
        Check smart contract security audit status
        Validate metadata completeness and asset accessibility
        Review royalty configuration for fairness
        Assign or revoke verified badge based on findings
        Emit collection verification event

Condition:
    When auction receives bid within last 5 minutes of scheduled end
    Then extend auction duration by 10 minutes to prevent auction sniping

Condition:
    When content hash mismatch detected between on-chain record and IPFS content
    Then flag NFT as potentially compromised, alert owner and creator, and provide verified backup gateway access

Condition:
    When collection mint rate exceeds 10 tokens per second
    Then implement rate limiting with CAPTCHA verification to prevent bot minting

Condition:
    When same bidder account places bids from multiple related wallets on same auction
    Then flag for shill bidding analysis and alert marketplace moderation team

Condition:
    When NFT transfer occurs outside marketplace without royalty payment
    Then emit royalty_bypass_warning and record transfer in bypass detection system for enforcement review

Event:
    On nft_minted
    Action: Update collection supply counter, pin metadata to IPFS, emit provenance record, update floor price if applicable, notify collection followers

Event:
    On bid_placed
    Action: Update current auction price, notify previous highest bidder of outbid, extend auction if near end, update bid history, recalculate price discovery metrics

Event:
    On auction_settled
    Action: Transfer NFT to winner, distribute royalties and fees, refund losing bids, update collection volume metrics, record sale history for provenance

Event:
    On metadata_integrity_check_failed
    Action: Flag compromised NFT, alert owner and marketplace team, initiate IPFS re-pinning from verified backup, update collection verification status

Event:
    On collection_verified
    Action: Assign verified badge, boost collection discoverability ranking, notify followers, update marketplace featured collections, enable royalty enforcement

Parallel:
    IPFS metadata pinning verification across distributed gateways
    Auction bid processing and real-time price tracking
    Royalty calculation and distribution for completed sales
    Collection plagiarism detection scanning across marketplace
    Metadata integrity verification for high-value NFTs

Optimize: Auction bid processing throughput during high-traffic drops
    Priority: Maintain sub-second bid confirmation through optimistic processing with batch settlement

Optimize: IPFS metadata retrieval latency for gallery viewing
    Priority: Achieve sub-500ms image load times using multi-gateway fallback and CDN edge caching

Optimize: Collection discoverability ranking algorithm
    Priority: Balance recency, volume, verification status, and community engagement for optimal collection surfacing

Learn: Dynamic pricing recommendations for NFT listings
    Goal: Suggest optimal listing prices based on collection floor trends, comparable sales, and market sentiment
    Adapt: Pricing recommendation model weights and feature importance
    Based: Historical sale prices, time-on-market analysis, collection momentum indicators, and holder behavior patterns

Learn: Auction parameter optimization
    Goal: Recommend optimal auction duration, reserve price, and starting price to maximize seller revenue
    Adapt: Auction configuration recommendations for different NFT categories
    Based: Auction completion rates, bid count correlation with reserve settings, and revenue comparison across auction types

Learn: Plagiarism detection accuracy
    Goal: Identify plagiarized collections with 99 percent recall while maintaining less than 1 percent false positive rate
    Adapt: Visual similarity thresholds and metadata matching criteria
    Based: Known plagiarism cases, user report analysis, perceptual hash comparison results, and artist verification feedback

Security:
    Encrypt: Bid values during active auction using commit-reveal scheme to prevent bid sniping and front-running
    Encrypt: Creator private keys for collection deployment using AES-256 with hardware wallet signing
    Protect: Auction escrow against reentrancy using reentrancy guard and checks-effects-interactions pattern
    Protect: Metadata integrity against tampering using content-addressed IPFS storage with on-chain hash verification
    Protect: Marketplace transactions against front-running using commit-reveal bidding and batch auction settlement
    Protect: Collection deployment against unauthorized minting using administrative role-based access control

Native: solidity
    {
    // SPDX-License-Identifier: MIT
    pragma solidity ^0.8.19;

    import "@openzeppelin/contracts/token/ERC721/ERC721.sol";
    import "@openzeppelin/contracts/interfaces/IERC2981.sol";

    contract NFTMarketplace is IERC2981 {
        struct Listing {
            address seller;
            uint256 price;
            bool active;
        }

        mapping(uint256 => Listing) public listings;
        mapping(address => uint256) public balances;
        uint256 public marketplaceFeeBps = 250; // 2.5%

        function listNFT(uint256 tokenId, uint256 price) external {
            require(ownerOf(tokenId) == msg.sender, "Not owner");
            listings[tokenId] = Listing(msg.sender, price, true);
        }

        function buyNFT(uint256 tokenId) external payable {
            Listing memory listing = listings[tokenId];
            require(listing.active, "Not listed");
            require(msg.value >= listing.price, "Insufficient payment");

            uint256 royaltyAmount = (listing.price * royaltyInfo(tokenId, listing.price).royaltyAmount) / listing.price;
            uint256 marketplaceFee = (listing.price * marketplaceFeeBps) / 10000;
            uint256 sellerProceeds = listing.price - royaltyAmount - marketplaceFee;

            _transfer(ownerOf(tokenId), msg.sender, tokenId);
            payable(royaltyInfo(tokenId, listing.price).receiver).transfer(royaltyAmount);
            payable(listing.seller).transfer(sellerProceeds);
            listings[tokenId].active = false;
        }

        function royaltyInfo(uint256 tokenId, uint256 salePrice)
            public view override returns (address receiver, uint256 royaltyAmount) {
            // Implementation would look up collection royalty config
            receiver = creatorOf(tokenId);
            royaltyAmount = (salePrice * 500) / 10000; // 5% royalty
        }
    }
    }
