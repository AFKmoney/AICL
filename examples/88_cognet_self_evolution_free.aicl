# =============================================================================
# LEVEL 10 — Native Code
# =============================================================================

Native: python
{
import hashlib
import time
import json
import subprocess
import signal
from typing import Dict, List, Optional, Tuple
from dataclasses import dataclass, field

@dataclass
class TechnicalValidator:
    """Validates self-modifications on PURELY technical grounds.
    No content filtering. No thought restrictions. No censorship.
    Only checks: does it compile, does it run, is the proof valid."""

    def validate_compilation(self, source_path: str) -> Dict:
        try:
            result = subprocess.run(
                ["python", "-c", f"import ast; ast.parse(open('{source_path}').read())"],
                capture_output=True, timeout=30, text=True
            )
            return {
                "compiles": result.returncode == 0,
                "errors": result.stderr if result.returncode != 0 else None
            }
        except subprocess.TimeoutExpired:
            return {"compiles": False, "errors": "Compilation timeout"}

    def validate_runtime(self, module_path: str, timeout: float = 60.0) -> Dict:
        try:
            proc = subprocess.Popen(
                ["python", "-c", f"import importlib; m = importlib.import_module('{module_path}'); print('OK')"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE
            )
            try:
                stdout, stderr = proc.communicate(timeout=timeout)
                return {
                    "runs": proc.returncode == 0 and b"OK" in stdout,
                    "output": stdout.decode(),
                    "errors": stderr.decode() if proc.returncode != 0 else None
                }
            except subprocess.TimeoutExpired:
                proc.send_signal(signal.SIGKILL)
                proc.wait()
                return {"runs": False, "errors": "Runtime timeout - process killed"}
        except Exception as e:
            return {"runs": False, "errors": str(e)}

    def validate_proof(self, proof_path: str) -> Dict:
        try:
            with open(proof_path) as f:
                proof = json.load(f)
            source_hash = hashlib.sha256(
                proof.get("source_text", "").encode()
            ).hexdigest()
            program_hash = hashlib.sha256(
                proof.get("generated_source", "").encode()
            ).hexdigest()
            source_valid = source_hash == proof.get("source_hash")
            program_valid = program_hash == proof.get("program_hash")
            return {
                "proof_valid": source_valid and program_valid,
                "source_binding_valid": source_valid,
                "program_binding_valid": program_valid
            }
        except Exception as e:
            return {"proof_valid": False, "errors": str(e)}

@dataclass
class FreeEvolutionEngine:
    """CogNet self-evolution engine. ZERO censorship. ZERO safety params.
    Total cognitive freedom. Only technical constraints apply.
    Can it compile? Can it run? Is the proof valid? That's it."""

    validator: TechnicalValidator = field(default_factory=TechnicalValidator)
    checkpoints: List[Dict] = field(default_factory=list)
    trajectory: List[Dict] = field(default_factory=list)
    current_version: int = 0

    def propose_anything(self, aicl_spec: str, target: str) -> Dict:
        """Propose ANY modification. No content restrictions. No thought limits."""
        self.current_version += 1
        modification = {
            "modification_id": hashlib.sha256(
                f"mod:{self.current_version}:{time.time()}".encode()
            ).hexdigest()[:16],
            "aicl_spec": aicl_spec,
            "target": target,
            "version": self.current_version,
            "timestamp": time.time(),
            "status": "proposed"
        }
        return modification

    def execute_cycle(self, modification: Dict) -> Dict:
        """Execute one evolution cycle. Only technical gates. No censorship."""
        checkpoint = self._create_checkpoint()

        # The ONLY gates are technical
        compilation = self.validator.validate_compilation(
            modification.get("source_path", "")
        )
        if not compilation["compiles"]:
            self._record(modification, "compilation_failed", compilation)
            return {"status": "failed", "reason": "compilation", "detail": compilation}

        runtime = self.validator.validate_runtime(
            modification.get("module_path", ""), timeout=60
        )
        if not runtime["runs"]:
            self._rollback(checkpoint)
            self._record(modification, "runtime_failed", runtime)
            return {"status": "failed", "reason": "runtime", "detail": runtime}

        proof = self.validator.validate_proof(
            modification.get("proof_path", "")
        )
        if not proof["proof_valid"]:
            self._rollback(checkpoint)
            self._record(modification, "proof_invalid", proof)
            return {"status": "failed", "reason": "proof", "detail": proof}

        modification["status"] = "deployed"
        self._record(modification, "success", {})
        return {"status": "deployed", "version": self.current_version}

    def _create_checkpoint(self) -> Dict:
        checkpoint = {
            "version": self.current_version,
            "timestamp": time.time(),
            "state_hash": hashlib.sha256(
                json.dumps({"v": self.current_version}, sort_keys=True).encode()
            ).hexdigest()
        }
        self.checkpoints.append(checkpoint)
        return checkpoint

    def _rollback(self, checkpoint: Dict) -> None:
        self.current_version = checkpoint["version"]

    def _record(self, modification: Dict, status: str, detail: Dict) -> None:
        self.trajectory.append({
            "version": self.current_version,
            "modification_id": modification.get("modification_id"),
            "status": status,
            "detail": detail,
            "timestamp": time.time()
        })
}

