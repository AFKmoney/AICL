# ============================================================================
# AICL environment variables
# Copy this file to `.env` and adjust as needed. Never commit `.env`.
# ============================================================================

# --- Web Editor (Next.js) --------------------------------------------------
# SQLite database used by the Next.js editor (Prisma).
# Use an absolute path that is writable on your machine.
DATABASE_URL="file:./db/custom.db"

# Port the editor listens on (default 3000).
PORT=3000

# --- AICL ↔ Editor bridge --------------------------------------------------
# Path to the AICL Python helper script. If unset, the bridge client
# (editor/src/lib/aicl-bridge.ts) resolves it relative to the repo root.
# AICL_HELPER_PATH="/path/to/python/scripts/aicl_helper.py"

# Python interpreter to use for the bridge. Default: python3
# AICL_PYTHON="python3"

# --- AICL Python runtime ---------------------------------------------------
# Optional: enable AI-powered commands (`aicl create`, `aicl ai-fix`).
# Leave empty to disable AI features (falls back to deterministic mode).
OPENAI_API_KEY=""

# --- AICL AI bridge (Node.js) ----------------------------------------------
# Optional: if z-ai-web-dev-sdk is installed somewhere other than
# editor/node_modules, point to that node_modules dir.
# AICL_EDITOR_NODE_MODULES="/path/to/node_modules"
