# ============================================================================
# AICL — .gitignore
# ============================================================================

# --- Secrets / env ---------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
*.so
.hypothesis/

# --- Node / Next.js / Bun --------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# --- Prisma / SQLite -------------------------------------------------------
/db/*.db
/db/*.db-journal
/prisma/migrations/dev/

# --- Build artifacts / runtime logs ----------------------------------------
output/
*.log
dev.log
server.log
dev.out.log
*.pid

# --- AI session state (never commit) ---------------------------------------
/skills/
.claude
.z-ai-config
agent-ctx/
worklog.md
.zscripts/

# --- Editor / OS -----------------------------------------------------------
.DS_Store
*.pem
*.swp
.idea/
.vscode/
local-*
